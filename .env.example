# PLANTILLA del archivo .env (sin contraseñas).
# En el servidor: copie este archivo con el nombre ".env" y escriba los datos reales.
# Los datos reales (servidores, usuarios y contraseñas) se piden al responsable de la app:
# NUNCA se suben a GitHub. El archivo .env está en el .gitignore.

# --- Base de datos de la app (MySQL). Obligatorio ---
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# --- Base Reportes de la empresa (SQL Server, solo lectura) ---
# Trae el código, el documento y el nombre del operador.
# Sin estos datos se usa solo el listado de respaldo (tabla operadores).
MSSQL_SERVER=
MSSQL_PORT=1433
MSSQL_USER=
MSSQL_PASSWORD=
REPORTES_DATABASE=Reportes

# --- Opcionales de la app ---
# Puerto en el que queda la app (por defecto 3000)
# PORT=3000
# Contraseña temporal de los usuarios nuevos y de "restablecer contraseña".
# Obligatoria para crear usuarios y restablecer contraseñas. Elija una y compártala en privado.
CLAVE_INICIAL=

# --- Correo (SMTP). Opcional ---
# Con estos datos la app avisa por correo cuando se crea un caso. Sin ellos no envía nada.
# Puerto 587 (STARTTLS) o 465 (SSL). SMTP_FROM es el remitente que verán las personas.
# APP_URL es la dirección con la que se entra a la app: con ella el correo lleva el enlace al caso.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Casos Vandalismo <casos@empresa.com>
# APP_URL=http://IP-DEL-SERVIDOR:3000
